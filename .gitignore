# CI: short-lived minted GitHub App token (WAL-72). Must never be committed and
# must be gitignored so `cog bump` (skip_untracked=false) sees a clean tree.
.ci-token

# Local Python/tooling caches
.pytest_cache/
__pycache__/
*.py[cod]

# Editor/OS noise
*~
.DS_Store

# Local VICE build trees
/vice/build-*/
/vice/build-test-*/
/vice/build/src/

# Autotools and compiler outputs. The generated configure, Makefile.in,
# aclocal.m4 and config.h.in files (libresidfp's included) are committed so a
# checkout builds without ./autogen.sh.
autom4te.cache/
.aclocal.out
.autoconf.out
.autoheader.out
.automake.out
configure~
config.log
config.status
*.o
*.a
*.lo
*.la
*.map
*.Po
*.Plo
.deps/
.libs/

# Local MCP test binaries
/vice/src/mcp/tests/test_mcp_tools
/vice/src/mcp/tests/test_mcp_transport
