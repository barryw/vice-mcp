# CI: short-lived minted GitHub App token (WAL-72). Must never be committed and
# must be gitignored so `cog bump` (skip_untracked=false) sees a clean tree.
.ci-token

# Local Python/tooling caches
.pytest_cache/
__pycache__/
*.py[cod]

# Editor/OS noise
*~
.DS_Store

# Local VICE build trees
/vice/build-*/
/vice/build-test-*/

# Autotools and compiler outputs
autom4te.cache/
config.log
config.status
*.o
*.a
*.lo
*.la
*.map
*.Po
*.Plo
.deps/
.libs/

# Local MCP test binaries
/vice/src/mcp/tests/test_mcp_tools
/vice/src/mcp/tests/test_mcp_transport
